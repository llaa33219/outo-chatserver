# Database
DATABASE_URL=sqlite+aiosqlite:///./data/chat.db

# Security
SECRET_KEY=change-me-to-a-random-secret-key-min-32-chars
TOKEN_EXPIRE_HOURS=24

# Encryption (Fernet key - generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=change-me-fernet-key

# Server
HOST=0.0.0.0
PORT=18279
